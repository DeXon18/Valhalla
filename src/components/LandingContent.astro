---
import Button from './Button.astro';
import type { Translations } from '../i18n/es';

interface Props {
	messages: Translations;
}

const { messages: t } = Astro.props;
---

<div class="space-y-24 sm:space-y-36 lg:space-y-48 min-w-0">
	<!-- ======================================================= -->
	<!-- 1. HERO MONUMENTAL DE MARCA                              -->
	<!-- ======================================================= -->
	<section id="hero" class="relative min-w-0 pt-4 sm:pt-10 lg:pt-16">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center min-w-0">
			<!-- Columna Textual y de Mando (7 cols ~ 58%) -->
			<div class="lg:col-span-7 space-y-8 text-left min-w-0 z-10">
				<div class="inline-flex items-center gap-3 px-3 py-1 rounded border border-border bg-surface text-xs font-mono tracking-widest text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
					<span>{t.landing.hero.eyebrow}</span>
				</div>

				<h1 class="font-heading font-bold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-foreground leading-[1.04]">
					{t.landing.hero.title}
				</h1>

				<p class="text-muted text-base sm:text-xl leading-relaxed max-w-xl font-normal">
					{t.landing.hero.description}
				</p>

				<div class="pt-2 sm:pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
					<Button variant="primary" href="#about-valhalla" class="w-full sm:w-auto px-6 py-3 text-base">
						{t.landing.hero.cta}
					</Button>
					<div class="hidden sm:flex items-center gap-2 text-xs font-mono text-muted pl-2">
						<span class="text-primary font-bold">/</span>
						<span>SELF-HOSTED STRENGTH</span>
					</div>
				</div>
			</div>

			<!-- Columna Escultórica: Monolito de Forja (5 cols ~ 42%) -->
			<div class="lg:col-span-5 min-w-0">
				<div class="relative rounded border border-border bg-surface p-2 sm:p-3 overflow-hidden aspect-[3/4] max-w-lg mx-auto lg:max-w-none shadow-2xl">
					<div class="relative w-full h-full rounded overflow-hidden">
						<img
							src="/images/landing-hero.jpg"
							alt=""
							class="w-full h-full object-cover object-center"
							loading="eager"
							decoding="async"
						/>
						<!-- Tratamiento de integración lumínica -->
						<div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent opacity-60 pointer-events-none" aria-hidden="true"></div>
						<div class="absolute top-4 left-4 border border-border-subtle bg-surface/80 backdrop-blur-sm px-2.5 py-1 rounded text-[10px] font-mono tracking-widest text-muted uppercase" aria-hidden="true">
							FIG // 01 — MASS & STEEL
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ======================================================= -->
	<!-- 2. SECCIÓN 01 — QUÉ ES VALHALLA (Superficie & 4 Pilares) -->
	<!-- ======================================================= -->
	<section id="about-valhalla" class="rounded border border-border bg-surface p-8 sm:p-12 lg:p-16 space-y-12 sm:space-y-16 min-w-0">
		<!-- Cabecera de la sección -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-baseline border-b border-border pb-8 sm:pb-12 min-w-0">
			<div class="lg:col-span-4 space-y-2">
				<div class="flex items-center gap-3">
					<span class="font-heading font-bold text-3xl sm:text-4xl text-primary" aria-hidden="true">01</span>
					<span class="text-xs uppercase tracking-widest text-muted font-semibold font-mono">SYSTEM CORE</span>
				</div>
				<p class="text-xs text-muted font-mono tracking-wider">ARCHITECTURE // PILLARS</p>
			</div>
			<div class="lg:col-span-8 space-y-4">
				<h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-foreground leading-tight">
					{t.landing.whatIs.heading}
				</h2>
				<p class="text-muted text-base sm:text-lg leading-relaxed max-w-3xl">
					{t.landing.whatIs.description}
				</p>
			</div>
		</div>

		<!-- Los 4 Pilares Fundacionales (Composición 2x2 Monumental) -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 min-w-0">
			<!-- Pilar 1 -->
			<div class="space-y-4 border-l-2 border-primary/60 pl-6 sm:pl-8 min-w-0">
				<div class="text-xs font-mono text-muted tracking-widest uppercase" aria-hidden="true">
					PILLAR 01 // STRENGTH
				</div>
				<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground tracking-tight">
					{t.landing.whatIs.pillar1Title}
				</h3>
				<p class="text-muted text-sm sm:text-base leading-relaxed">
					{t.landing.whatIs.pillar1Desc}
				</p>
			</div>

			<!-- Pilar 2 -->
			<div class="space-y-4 border-l-2 border-primary/60 pl-6 sm:pl-8 min-w-0">
				<div class="text-xs font-mono text-muted tracking-widest uppercase" aria-hidden="true">
					PILLAR 02 // PROGRESSION
				</div>
				<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground tracking-tight">
					{t.landing.whatIs.pillar2Title}
				</h3>
				<p class="text-muted text-sm sm:text-base leading-relaxed">
					{t.landing.whatIs.pillar2Desc}
				</p>
			</div>

			<!-- Pilar 3 -->
			<div class="space-y-4 border-l-2 border-primary/60 pl-6 sm:pl-8 min-w-0">
				<div class="text-xs font-mono text-muted tracking-widest uppercase" aria-hidden="true">
					PILLAR 03 // INFRASTRUCTURE
				</div>
				<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground tracking-tight">
					{t.landing.whatIs.pillar3Title}
				</h3>
				<p class="text-muted text-sm sm:text-base leading-relaxed">
					{t.landing.whatIs.pillar3Desc}
				</p>
			</div>

			<!-- Pilar 4 -->
			<div class="space-y-4 border-l-2 border-primary/60 pl-6 sm:pl-8 min-w-0">
				<div class="text-xs font-mono text-muted tracking-widest uppercase" aria-hidden="true">
					PILLAR 04 // SOVEREIGNTY
				</div>
				<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground tracking-tight">
					{t.landing.whatIs.pillar4Title}
				</h3>
				<p class="text-muted text-sm sm:text-base leading-relaxed">
					{t.landing.whatIs.pillar4Desc}
				</p>
			</div>
		</div>
	</section>

	<!-- ======================================================= -->
	<!-- 3. SECCIÓN 02 — QUÉ ESTAMOS CONSTRUYENDO (Roadmap)      -->
	<!-- ======================================================= -->
	<section id="building" class="space-y-12 sm:space-y-16 min-w-0 border-t border-border pt-16 sm:pt-24">
		<!-- Cabecera con Badge de desarrollo activo -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-baseline min-w-0">
			<div class="lg:col-span-4 space-y-2">
				<div class="flex items-center gap-3">
					<span class="font-heading font-bold text-3xl sm:text-4xl text-primary" aria-hidden="true">02</span>
					<span class="text-xs uppercase tracking-widest text-muted font-semibold font-mono">ROADMAP</span>
				</div>
				<span class="inline-block text-xs px-2.5 py-0.5 rounded border border-control-border bg-raised text-foreground font-mono">
					{t.landing.building.badge}
				</span>
			</div>
			<div class="lg:col-span-8 space-y-4">
				<h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-foreground leading-tight">
					{t.landing.building.heading}
				</h2>
				<p class="text-muted text-base sm:text-lg leading-relaxed max-w-3xl">
					{t.landing.building.description}
				</p>
			</div>
		</div>

		<!-- Estructura de Progresión 01 / 02 / 03 -->
		<div class="space-y-6 min-w-0">
			<!-- Bloque 1 -->
			<div class="rounded border border-border bg-surface p-6 sm:p-10 transition-colors duration-150 motion-reduce:transition-none hover:border-primary/50 min-w-0">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center min-w-0">
					<div class="md:col-span-2 font-heading font-bold text-3xl sm:text-4xl text-primary/80" aria-hidden="true">
						01
					</div>
					<div class="md:col-span-4">
						<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground">
							{t.landing.building.block1Title}
						</h3>
					</div>
					<div class="md:col-span-6">
						<p class="text-muted text-sm sm:text-base leading-relaxed">
							{t.landing.building.block1Desc}
						</p>
					</div>
				</div>
			</div>

			<!-- Bloque 2 -->
			<div class="rounded border border-border bg-surface p-6 sm:p-10 transition-colors duration-150 motion-reduce:transition-none hover:border-primary/50 min-w-0">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center min-w-0">
					<div class="md:col-span-2 font-heading font-bold text-3xl sm:text-4xl text-primary/80" aria-hidden="true">
						02
					</div>
					<div class="md:col-span-4">
						<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground">
							{t.landing.building.block2Title}
						</h3>
					</div>
					<div class="md:col-span-6">
						<p class="text-muted text-sm sm:text-base leading-relaxed">
							{t.landing.building.block2Desc}
						</p>
					</div>
				</div>
			</div>

			<!-- Bloque 3 -->
			<div class="rounded border border-border bg-surface p-6 sm:p-10 transition-colors duration-150 motion-reduce:transition-none hover:border-primary/50 min-w-0">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center min-w-0">
					<div class="md:col-span-2 font-heading font-bold text-3xl sm:text-4xl text-primary/80" aria-hidden="true">
						03
					</div>
					<div class="md:col-span-4">
						<h3 class="font-heading font-bold text-xl sm:text-2xl text-foreground">
							{t.landing.building.block3Title}
						</h3>
					</div>
					<div class="md:col-span-6">
						<p class="text-muted text-sm sm:text-base leading-relaxed">
							{t.landing.building.block3Desc}
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ======================================================= -->
	<!-- 4. CIERRE DE MARCA MONUMENTAL                            -->
	<!-- ======================================================= -->
	<section id="closing" class="rounded border border-border bg-raised p-10 sm:p-16 lg:p-24 text-center space-y-8 min-w-0 relative overflow-hidden">
		<div class="w-16 h-1 bg-primary mx-auto rounded-full" aria-hidden="true"></div>
		
		<div class="space-y-4 max-w-3xl mx-auto">
			<p class="font-heading font-bold text-2xl sm:text-4xl lg:text-5xl tracking-tight text-foreground leading-tight">
				{t.landing.closing.message}
			</p>
			<p class="text-muted text-base sm:text-lg font-mono tracking-wide">
				{t.landing.closing.tagline}
			</p>
		</div>
	</section>
</div>