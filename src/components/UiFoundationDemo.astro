---
import Card from './Card.astro';
import Button from './Button.astro';
import TextInput from './TextInput.astro';
import FeedbackState from './FeedbackState.astro';
import type { Translations } from '../i18n/es';

interface Props {
	messages: Translations;
}

const { messages: t } = Astro.props;
---

<!-- Título y texto principal/secundario -->
<header class="space-y-2">
	<h1 class="font-heading font-bold text-2xl tracking-wide text-foreground">
		{t.page.heading}
	</h1>
	<p class="text-muted text-sm leading-relaxed">
		{t.page.description}
	</p>
</header>

<!-- Contenedor adaptativo para secciones técnicas en tablet y desktop -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 min-w-0">
	<!-- Superficies y bordes (Card base) -->
	<Card variant="surface" class="space-y-3 min-w-0">
		<h2 class="text-xs uppercase tracking-wider text-muted font-semibold">
			{t.sections.surfaces}
		</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
			<div class="bg-background p-3 rounded border border-border">
				<span class="text-muted">{t.surfaces.background}</span>
			</div>
			<div class="bg-surface p-3 rounded border border-border">
				<span class="text-foreground">{t.surfaces.surface}</span>
			</div>
			<div class="bg-raised p-3 rounded border border-border sm:col-span-2">
				<span class="text-foreground">{t.surfaces.raised}</span>
			</div>
		</div>
	</Card>

	<!-- Cards & Contenedores -->
	<Card variant="surface" class="space-y-3 min-w-0">
		<h2 class="text-xs uppercase tracking-wider text-muted font-semibold">
			{t.sections.cards}
		</h2>
		<div class="space-y-3 text-xs">
			<Card variant="surface" class="space-y-1">
				<div class="font-semibold text-foreground">{t.cards.surfaceTitle}</div>
				<p class="text-muted leading-relaxed">{t.cards.surfaceDesc}</p>
			</Card>
			<Card variant="raised" class="space-y-1">
				<div class="font-semibold text-foreground">{t.cards.raisedTitle}</div>
				<p class="text-muted leading-relaxed">{t.cards.raisedDesc}</p>
			</Card>
		</div>
	</Card>
</div>

<!-- Spacing Scale -->
<Card variant="surface" class="space-y-3 min-w-0">
	<h2 class="text-xs uppercase tracking-wider text-muted font-semibold">
		{t.sections.spacing}
	</h2>
	<div class="space-y-2 text-xs text-muted">
		<div class="flex items-center gap-2 min-w-0">
			<span class="w-12 shrink-0">p-1:</span>
			<div class="bg-primary-subtle border border-primary p-1 text-primary">1 (4px)</div>
		</div>
		<div class="flex items-center gap-2 min-w-0">
			<span class="w-12 shrink-0">p-2:</span>
			<div class="bg-primary-subtle border border-primary p-2 text-primary">2 (8px)</div>
		</div>
		<div class="flex items-center gap-2 min-w-0">
			<span class="w-12 shrink-0">p-3:</span>
			<div class="bg-primary-subtle border border-primary p-3 text-primary">3 (12px)</div>
		</div>
		<div class="flex items-center gap-2 min-w-0">
			<span class="w-12 shrink-0">p-4:</span>
			<div class="bg-primary-subtle border border-primary p-4 text-primary">4 (16px)</div>
		</div>
	</div>
</Card>

<!-- Controles (Button), Estados y Badges -->
<Card variant="surface" class="space-y-3 min-w-0">
	<h2 class="text-xs uppercase tracking-wider text-muted font-semibold">
		{t.sections.controls}
	</h2>

	<!-- Botones adaptativos mobile-first reutilizando Button.astro -->
	<div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3">
		<Button variant="primary" type="button" class="w-full sm:w-auto">
			{t.actions.primary}
		</Button>

		<Button variant="secondary" type="button" class="w-full sm:w-auto">
			{t.actions.secondary}
		</Button>

		<Button variant="primary" type="button" disabled class="w-full sm:w-auto">
			{t.actions.disabled}
		</Button>
	</div>

	<!-- Badges semánticos flexibles -->
	<div class="flex flex-wrap items-center gap-2 pt-2">
		<span class="text-xs px-2 py-0.5 rounded border border-success text-success font-medium">
			{t.states.success}
		</span>
		<span class="text-xs px-2 py-0.5 rounded border border-warning text-warning font-medium">
			{t.states.warning}
		</span>
		<span class="text-xs px-2 py-0.5 rounded border border-danger text-danger font-medium">
			{t.states.danger}
		</span>
	</div>

	<!-- Elemento Selected -->
	<div class="pt-2">
		<div class="p-3 rounded border border-primary bg-primary-subtle text-xs text-foreground font-medium">
			{t.states.selected}
		</div>
	</div>
</Card>

<!-- Campos de Texto (TextInput) -->
<Card variant="surface" class="space-y-4 min-w-0">
	<h2 class="text-xs uppercase tracking-wider text-muted font-semibold">
		{t.sections.inputs}
	</h2>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
		<TextInput
			id="demo-input-normal"
			name="demo-normal"
			label={t.inputs.normalLabel}
			placeholder={t.inputs.normalPlaceholder}
		/>
		<TextInput
			id="demo-input-help"
			name="demo-help"
			type="email"
			label={t.inputs.withHelpLabel}
			placeholder={t.inputs.withHelpPlaceholder}
			helpText={t.inputs.withHelpText}
		/>
		<TextInput
			id="demo-input-error"
			name="demo-error"
			type="password"
			label={t.inputs.withErrorLabel}
			value={t.inputs.withErrorValue}
			errorMessage={t.inputs.withErrorMessage}
			required
		/>
	</div>
</Card>

<!-- Estados de Feedback (FeedbackState) -->
<Card variant="surface" class="space-y-4 min-w-0">
	<h2 class="text-xs uppercase tracking-wider text-muted font-semibold">
		{t.sections.feedbackDemo}
	</h2>
	<div class="space-y-4">
		<FeedbackState
			variant="loading"
			title={t.feedback.loading.title}
			description={t.feedback.loading.description}
		/>
		<FeedbackState
			variant="empty"
			title={t.feedback.empty.title}
			description={t.feedback.empty.description}
		/>
		<FeedbackState
			variant="error"
			title={t.feedback.error.title}
			description={t.feedback.error.description}
		/>
	</div>
</Card>