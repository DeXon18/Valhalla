---
import '../styles/global.css';

interface Props {
	locale: 'es' | 'en';
	title: string;
}

const { locale, title } = Astro.props;
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-background text-foreground font-body p-4 sm:p-6 lg:p-8 min-w-0">
		<slot />
	</body>
</html>