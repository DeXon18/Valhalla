---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import { locales, defaultLocale, getTranslations, type Locale } from '../i18n/config';
import { getRelativeLocaleUrl } from 'astro:i18n';

const firstSegment = Astro.url.pathname.split('/').filter(Boolean)[0];
const locale: Locale = locales.includes(firstSegment as Locale)
	? (firstSegment as Locale)
	: defaultLocale;

const messages = getTranslations(locale);
const homeUrl = getRelativeLocaleUrl(locale, '');
---

<BaseLayout locale={locale} title={messages.notFound.title}>
	<AppShell locale={locale} messages={messages} homeIsCurrent={false}>
		<div class="p-6 rounded border border-border bg-surface text-foreground space-y-4 max-w-lg mx-auto text-center sm:text-left">
			<div class="space-y-2">
				<h1 class="font-heading font-bold text-2xl tracking-wide text-foreground">
					{messages.notFound.heading}
				</h1>
				<p class="text-muted text-sm leading-relaxed">
					{messages.notFound.description}
				</p>
			</div>

			<div class="pt-2">
				<a
					href={homeUrl}
					class="inline-block bg-primary text-primary-foreground font-semibold px-4 py-2 rounded text-sm hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-none"
				>
					{messages.notFound.backHome}
				</a>
			</div>
		</div>
	</AppShell>
</BaseLayout>