---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { locales, defaultLocale, getTranslations, type Locale } from '../i18n/config';
import { getRelativeLocaleUrl } from 'astro:i18n';

const firstSegment = Astro.url.pathname.split('/').filter(Boolean)[0];
const locale: Locale = locales.includes(firstSegment as Locale)
	? (firstSegment as Locale)
	: defaultLocale;

const messages = getTranslations(locale);
const homeUrl = getRelativeLocaleUrl(locale, '');
---

<BaseLayout locale={locale} title={messages.notFound.title}>
	<AppShell locale={locale} messages={messages} homeIsCurrent={false}>
		<Card variant="surface" class="space-y-4 max-w-lg mx-auto text-center sm:text-left">
			<div class="space-y-2">
				<h1 class="font-heading font-bold text-2xl tracking-wide text-foreground">
					{messages.notFound.heading}
				</h1>
				<p class="text-muted text-sm leading-relaxed">
					{messages.notFound.description}
				</p>
			</div>

			<div class="pt-2">
				<Button variant="primary" href={homeUrl}>
					{messages.notFound.backHome}
				</Button>
			</div>
		</Card>
	</AppShell>
</BaseLayout>