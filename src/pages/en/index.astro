---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import UiFoundationDemo from '../../components/UiFoundationDemo.astro';
import { getTranslations } from '../../i18n/config';

const locale = 'en';
const messages = getTranslations(locale);
---

<BaseLayout locale={locale} title={messages.page.title}>
	<AppShell locale={locale} messages={messages}>
		<UiFoundationDemo messages={messages} />
	</AppShell>
</BaseLayout>