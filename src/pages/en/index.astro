---
import '../../styles/global.css';
import UiFoundationDemo from '../../components/UiFoundationDemo.astro';
import { getTranslations } from '../../i18n/config';

const locale = 'en';
const messages = getTranslations(locale);
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{messages.page.title}</title>
	</head>
	<body class="bg-background text-foreground font-body p-4 sm:p-6 lg:p-8 min-w-0">
		<UiFoundationDemo locale={locale} messages={messages} />
	</body>
</html>