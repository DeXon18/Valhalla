---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import LandingContent from '../components/LandingContent.astro';
import { getTranslations } from '../i18n/config';

const locale = 'es';
const messages = getTranslations(locale);
---

<BaseLayout locale={locale} title={messages.page.title}>
	<AppShell locale={locale} messages={messages} wide={true}>
		<LandingContent messages={messages} />
	</AppShell>
</BaseLayout>